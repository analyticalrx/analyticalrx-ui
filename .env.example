# Spring Boot service; called by the Next.js server (no browser CORS setup required).
DATA_PLATFORM_API_URL=http://127.0.0.1:8080

# Match the backend's JWT_ISSUER and JWT_AUDIENCE.
AUTH_JWT_ISSUER=analyticalrx-api
AUTH_JWT_AUDIENCE=analyticalrx-frontend

# Provide the SAME Base64 secret as the backend JWT_SIGNING_SECRET, server-side only.
# Prefer injecting JWT_SIGNING_SECRET into both services from your secret manager.
# AUTH_JWT_SECRET=your-backend-base64-secret
AUTH_JWT_SECRET_ENCODING=base64

# The current backend issues these claims. Role values may be uppercase.
AUTH_ROLE_CLAIM=roles
AUTH_NAME_CLAIM=display_name
AUTH_STORE_CLAIM=store_id

# Optional asymmetric identity provider alternative; leave unset for Spring Boot HMAC.
# AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
